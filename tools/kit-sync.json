        "thinking-control"
      ],
      "rewrite": [
        [
          "../vendor/code-kit/pure/",
          "../kit/"
        ],
        [
          "../vendor/code-kit/web/",
          "../kit/"
        ],
        [
          "../pure/",
          "../kit/"
        ]
      ]
    },
    {
      "dir": "tests/vendor/kit",
      "source": "obsidian-kit",
      "from": "src/testing",
      "modules": [
        "kit-css",
        "obsidian-mock"
