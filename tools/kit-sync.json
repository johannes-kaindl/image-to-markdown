        ]
      ]
    },
    {
      "dir": "src/vendor/kit",
      "source": "code-kit",
      "from": "src/ts/pure",
      "modules": [
        "backend-probe",
        "capabilities",
        "diff",
        "embeddings-client",
        "endpoint",
        "endpoint_config",
        "endpoint_diagnostics",
        "error_body",
        "model-choice",
        "model-context",
        "model-list-cache",
        "reasoning",
        "redact",
        "rounds",
        "sampling-profiles",
        "secrets",
        "settings",
        "sse",
        "think-splitter",
        "timeout"
      ]
    },
    {
      "dir": "src/vendor/kit",
      "source": "code-kit",
      "from": "src/ts/web",
      "modules": [
        "clipboard"
      ]
    },
    {
      "dir": "src/vendor/kit-obsidian",
      "source": "obsidian-kit",
