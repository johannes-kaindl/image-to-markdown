{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    // Der Treiber redet mit einem fremden Renderer (Obsidians `app`, CDP-Antworten) —
    // DOM-Typen fuer die Ausdruecke, die dort laufen, plus `lib.dom` fuer `WebSocket`.
    "lib": ["ES2022", "DOM"],
    "noEmit": true
  },
  "include": ["scripts/**/*.ts"]
}
